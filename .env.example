# Techies App Environment Configuration Template
# Copy this file to .env for local development

# API Configuration
API_BASE_URL=https://techies.app

# Android Release Signing Credentials (Optional / Production CI/CD)
MYAPP_RELEASE_STORE_FILE=release.keystore
MYAPP_RELEASE_STORE_PASSWORD=your_keystore_password_here
MYAPP_RELEASE_KEY_ALIAS=your_key_alias_here
MYAPP_RELEASE_KEY_PASSWORD=your_key_password_here
